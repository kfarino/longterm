  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dashboard-server.mjs",
    "seed": "node scripts/seed-from-examples.mjs",
    "build": "node data/build-data.mjs && node data/build-goal-plan-md.mjs",
    "oura:auth": "node scripts/oura-auth-setup.mjs",
    "oura:pull": "node scripts/oura-pull.mjs",
    "spotify:auth": "node scripts/spotify-auth-setup.mjs",
    "spotify:pull": "node scripts/spotify-pull.mjs",
    "spotify:find-shows": "node scripts/spotify-find-shows.mjs",
    "spotify:match": "node scripts/spotify-match-shows.mjs",
